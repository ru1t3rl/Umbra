{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Umbra behavior graph file, format v1",
  "description": "A behavior graph is a `*.behavior.toml` file (ADR 0012). This schema checks the structure only. The reader checks what a schema cannot: ID and name grammar, semantic versions, node names that resolve, reachability, FSM guards, interface bindings and subgraph cycles. Hand-written next to the reader; the reader is authoritative.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "description": "A namespaced ID such as `example.behavior.patrol`"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "A node, state, exit, parameter or blackboard key name, `[a-z][a-z0-9_]*`"
    },
    "node": {
      "description": "One node; `type` selects the settings.",
      "oneOf": [
        {
          "title": "sequence node",
          "description": "Ticks children in order; Failure or Running of a child ends the tick, Success when all succeed. Reactive unless memory is set.",
          "type": "object",
          "properties": {
            "type": {
              "const": "sequence",
              "description": "Node type."
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Name of a child node."
              },
              "minItems": 1,
              "description": "Children ticked in order until one fails or is Running."
            },
            "memory": {
              "type": "boolean",
              "default": false,
              "description": "When true, resume at the Running child instead of re-checking from the first child every tick."
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "title": "selector node",
          "description": "Ticks children in order; Success or Running of a child ends the tick, Failure when all fail. Reactive unless memory is set.",
          "type": "object",
          "properties": {
            "type": {
              "const": "selector",
              "description": "Node type."
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Name of a child node."
              },
              "minItems": 1,
              "description": "Children ticked in order until one succeeds or is Running."
            },
            "memory": {
              "type": "boolean",
              "default": false,
              "description": "When true, resume at the Running child instead of re-checking from the first child every tick."
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "title": "parallel node",
          "description": "Ticks every unfinished child each tick; the policy decides when it finishes.",
          "type": "object",
          "properties": {
            "type": {
              "const": "parallel",
              "description": "Node type."
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Name of a child node."
              },
              "minItems": 1,
              "description": "Children ticked every tick in order."
            },
            "policy": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ],
              "default": "all",
              "description": "all: Success when every child succeeded, Failure on the first failure. any: Success on the first success, Failure when all failed."
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "title": "inverter node",
          "description": "Swaps the child's Success and Failure; Running passes through.",
          "type": "object",
          "properties": {
            "type": {
              "const": "inverter",
              "description": "Node type."
            },
            "child": {
              "type": "string",
              "description": "Child whose Success and Failure are swapped."
            }
          },
          "required": [
            "type",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "title": "succeed_always node",
          "description": "Reports the child's Failure as Success; Running passes through.",
          "type": "object",
          "properties": {
            "type": {
              "const": "succeed_always",
              "description": "Node type."
            },
            "child": {
              "type": "string",
              "description": "Child whose Failure is reported as Success."
            }
          },
          "required": [
            "type",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "title": "repeat node",
          "description": "Ticks its child at most once per tick, repeating it until count successes (forever when absent).",
          "type": "object",
          "properties": {
            "type": {
              "const": "repeat",
              "description": "Node type."
            },
            "child": {
              "type": "string",
              "description": "Child ticked at most once per tick."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of child successes before Success; absent repeats forever."
            }
          },
          "required": [
            "type",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "title": "cooldown node",
          "description": "After the child finishes, fails without ticking it until the duration has elapsed.",
          "type": "object",
          "properties": {
            "type": {
              "const": "cooldown",
              "description": "Node type."
            },
            "child": {
              "type": "string",
              "description": "Child gated by the cooldown."
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Duration in seconds; converted to whole ticks at the scenario rate (at least one tick)."
            }
          },
          "required": [
            "type",
            "child",
            "duration_s"
          ],
          "additionalProperties": false
        },
        {
          "title": "timeout node",
          "description": "Halts the child and fails when it is still Running after the duration.",
          "type": "object",
          "properties": {
            "type": {
              "const": "timeout",
              "description": "Node type."
            },
            "child": {
              "type": "string",
              "description": "Child aborted when it runs too long."
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Duration in seconds; converted to whole ticks at the scenario rate (at least one tick)."
            }
          },
          "required": [
            "type",
            "child",
            "duration_s"
          ],
          "additionalProperties": false
        },
        {
          "title": "condition node",
          "description": "Leaf that checks a catalog condition; returns Success or Failure, never Running.",
          "type": "object",
          "properties": {
            "type": {
              "const": "condition",
              "description": "Node type."
            },
            "ref": {
              "type": "string",
              "description": "Catalog ID of the condition."
            },
            "params": {
              "type": "object",
              "description": "Condition parameters; values may be { param = \"<interface param>\" } references."
            }
          },
          "required": [
            "type",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "title": "action node",
          "description": "Leaf that runs a catalog action; may return Success, Failure or Running.",
          "type": "object",
          "properties": {
            "type": {
              "const": "action",
              "description": "Node type."
            },
            "ref": {
              "type": "string",
              "description": "Catalog ID of the action."
            },
            "params": {
              "type": "object",
              "description": "Action parameters; values may be { param = \"<interface param>\" } references."
            }
          },
          "required": [
            "type",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "title": "subgraph node",
          "description": "Runs another behavior graph with its own blackboard, bound by interface parameters and outputs.",
          "type": "object",
          "properties": {
            "type": {
              "const": "subgraph",
              "description": "Node type."
            },
            "ref": {
              "type": "string",
              "description": "Catalog ID of the behavior graph."
            },
            "version": {
              "type": "string",
              "description": "Semver range the referenced graph must satisfy (for example ^1.0); absent accepts any version."
            },
            "params": {
              "type": "object",
              "description": "Child interface parameters: literals, { param = \"<name>\" } build-time references, or { key = \"<blackboard key>\" } run-time input bindings."
            },
            "outputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "description": "Parent blackboard key."
              },
              "description": "Child output port to parent blackboard key."
            }
          },
          "required": [
            "type",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "title": "fsm node",
          "description": "Finite state machine whose states are nodes; guard and completion transitions, named exits mapped to Success or Failure.",
          "type": "object",
          "properties": {
            "type": {
              "const": "fsm",
              "description": "Node type."
            },
            "initial": {
              "type": "string",
              "description": "Name of the initial state."
            },
            "states": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "description": "Node run while the state is current."
              },
              "description": "State name to node name."
            },
            "exits": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "success",
                  "failure"
                ]
              },
              "description": "Exit name to the status the FSM returns when entered."
            },
            "transitions": {
              "type": "array",
              "description": "Transitions in file order; each has from, to and exactly one of when or on.",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "Source state."
                  },
                  "to": {
                    "type": "string",
                    "description": "Target state or exit."
                  },
                  "when": {
                    "type": "string",
                    "description": "Guard node (condition, inverter, sequence, selector only). Exactly one of when or on."
                  },
                  "on": {
                    "type": "string",
                    "enum": [
                      "success",
                      "failure"
                    ],
                    "description": "Fires when the current state's node finishes with this status (success or failure). Exactly one of when or on."
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "when"
                    ]
                  },
                  {
                    "required": [
                      "on"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "type",
            "initial",
            "states"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Format version of this file; 1 is the only one."
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "description": "Semantic version of the graph, MAJOR.MINOR.PATCH."
    },
    "description": {
      "type": "string",
      "description": "Shown in the catalog."
    },
    "root": {
      "type": "string",
      "description": "Name of the root node."
    },
    "interface": {
      "type": "object",
      "description": "Parameters, output ports and result text of the graph (ADR 0014).",
      "properties": {
        "params": {
          "type": "object",
          "description": "Parameter name to a fragment: `type` (boolean, number, integer, string, entity, position), optional `default`, and JSON Schema keywords such as minimum. `entity` and `position` are binding-only and cannot have a default.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "boolean",
                  "number",
                  "integer",
                  "string",
                  "entity",
                  "position"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "outputs": {
          "type": "object",
          "description": "Output port name to the blackboard key it reads when the graph finishes.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bool",
                  "number",
                  "integer",
                  "string",
                  "entity",
                  "position"
                ]
              },
              "from": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "from"
            ],
            "additionalProperties": false
          }
        },
        "result": {
          "type": "string",
          "description": "What Success, Failure and Running mean for this graph."
        }
      },
      "additionalProperties": false
    },
    "blackboard": {
      "type": "object",
      "description": "Blackboard key name to its type.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "bool",
          "number",
          "integer",
          "string",
          "entity",
          "position"
        ]
      }
    },
    "nodes": {
      "type": "object",
      "description": "Node name to node.",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "editor": {
      "type": "object",
      "description": "Editor data (positions, comments); ignored by the engine."
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "root",
    "nodes"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": 1,
      "id": "example.behavior.follow",
      "version": "1.0.0",
      "root": "go",
      "nodes": {
        "go": {
          "type": "action",
          "ref": "builtin.action.follow_route"
        }
      }
    }
  ]
}
