{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Umbra template file, format v1",
  "description": "One template per file. IDs follow ADR 0002 (lowercase dot-separated segments, at least two); the reader checks the grammar and the registry, this schema checks structure. Hand-written next to the reader; the reader is authoritative.",
  "$defs": {
    "id": { "type": "string", "minLength": 3, "maxLength": 128, "description": "A namespaced ID such as `builtin.ground.kinematic`" },
    "params": { "type": "object", "description": "Component parameters, validated against the component's own schema" },
    "component": {
      "type": "object",
      "properties": {
        "model": { "$ref": "#/$defs/id" },
        "params": { "$ref": "#/$defs/params" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1, "description": "Format version; only 1 is supported" },
    "id": { "$ref": "#/$defs/id" },
    "extends": { "$ref": "#/$defs/id" },
    "description": { "type": "string" },
    "motion": { "$ref": "#/$defs/component" },
    "behavior": {
      "type": "object",
      "properties": {
        "ref": { "$ref": "#/$defs/id" },
        "params": { "$ref": "#/$defs/params" }
      },
      "additionalProperties": false
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "$ref": "#/$defs/id" },
          "params": { "$ref": "#/$defs/params" }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "description": "One opaque table per adapter (`[a-z][a-z0-9_]*`), kept verbatim and handed to the adapter",
      "additionalProperties": { "type": "object" }
    }
  },
  "required": ["schema_version", "id"],
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": 1,
      "id": "tank.mbt_generic",
      "extends": "ground_vehicle.base",
      "motion": { "params": { "max_turn_rate_dps": 30.0 } }
    }
  ]
}
